# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# UniPad: 运行证据与产物（PRD §9：不入 Git）
runs/*/
!runs/.gitkeep
!runs/README.md
artifacts/*
!artifacts/.gitkeep
!artifacts/README.md

# UniPad: 私有素材（PRD §12：绝不入 Git）
local-private/
*.ipsw
*.dmg
*.img
*.qcow2
*.vmdk
*.raw

# The pinned third-party checkouts, and everything a build lays down inside
# them.  NOT tracked: the lock (config/sources.lock.json) names the commits, and
# a checkout is re-fetchable from them.
#
# This entry used to live only in .git/info/exclude, which is LOCAL state -- it
# is not part of the repository, so a clone does not inherit it and a fresh
# `git add -A` in one stages the whole checkout.  That mattered on 2026-10-26:
# vendor/UniXNU/refer is a junction pointing at local-private/ipsw, so a single
# 6.8 GiB Apple restore image sits inside the working tree, reachable by a glob,
# excluded by a rule that only this machine has.  Moving the rule here is what
# makes the exclusion travel with the repository instead of with the clone.
vendor/
*.sparseimage
# PRD 12 names these two explicitly as material that must never enter the
# source tree.  They were missing while the workflow's PRIVATE_PATTERNS listed
# them, so the runner would have refused to upload one and Git would have
# accepted a commit of it -- two guards, one hole.
*.trustcache
*.seed

# 密钥与凭证
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
*.cer
*.mobileconfig
*.iso
secrets.json

# 编辑器 / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# 测试运行残留物
.pytest-refute.tmp
.pytest-launcher-scratch/
fake-qemu-args.json

# 编译探针残留物
/a.out
/a.o
.suite-run.txt

# macOS 构建入口的默认输出目录（--out 未给出时落在仓库内）
scripts/macos/build-out/

# 平台种子：按设计不入任何仓库（unipad.host.adt.SEED_LABEL 的域分隔即为此设）。
# build-macos.sh 把它写在运行自己的 workspace 下，从不写进 checkout；这两行是
# 防止有人用默认 --out 在仓库里跑一次之后顺手 git add -A 的兜底。
platform-seed
platform-seed.json
